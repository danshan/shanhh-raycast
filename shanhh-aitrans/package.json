{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "shanhh-aitrans",
  "type": "module",
  "title": "Shanhh AI Translator",
  "description": "Translate text with an OpenAI-compatible API.",
  "icon": "extension-icon-transparent.png",
  "author": "danshan",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "index",
      "title": "AI Translate",
      "description": "Translate text with an OpenAI-compatible API",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiBaseUrl",
      "type": "textfield",
      "required": true,
      "title": "API Base URL",
      "description": "OpenAI-compatible API base URL, including the API version path.",
      "placeholder": "https://api.example.com/v1"
    },
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "API Key",
      "description": "API key sent as a Bearer token."
    },
    {
      "name": "model",
      "type": "textfield",
      "required": true,
      "title": "Model",
      "description": "Model name exposed by the configured API.",
      "placeholder": "provider-model-name"
    },
    {
      "name": "targetLanguage1",
      "type": "dropdown",
      "required": true,
      "title": "Target Language 1",
      "description": "Primary default target language.",
      "default": "zh-CN",
      "data": [
        {
          "title": "Simplified Chinese",
          "value": "zh-CN"
        },
        {
          "title": "Traditional Chinese",
          "value": "zh-TW"
        },
        {
          "title": "English",
