{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "shanhh-myip",
  "title": "Shanhh My IP",
  "description": "Show local and public IP addresses with lookup.",
  "icon": "extension-icon.png",
  "author": "danshan",
  "owner": "shanhh",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Shanhh My IP",
      "description": "Show local and public IP addresses",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.94.0",
    "got": "^14.2.1",
    "ip": "^2.0.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/got": "^9.6.12",
    "@types/node": "20.8.10",
    "@types/react": "19.0.10",
    "@types/ip": "^1.1.3",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
