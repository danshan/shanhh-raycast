{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "shanhh-totp",
  "title": "Shanhh TOTP",
  "description": "TOTP 2FA code generator.",
  "icon": "command-icon.png",
  "author": "danshan",
  "owner": "shanhh",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Shanhh TOTP",
      "description": "Generate TOTP 2FA codes from a local auth file",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "authFile",
      "description": "TOTP Auth File",
      "type": "file",
      "required": true,
      "title": "TOTP Auth File"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.94.0",
    "otpauth": "^9.2.4"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "20.8.10",
    "@types/react": "19.0.10",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
